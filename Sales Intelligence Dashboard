# Build DataFrames
def build_df(raw, year):
    rows = []
    for m in MONTHS:
        d = raw[m]
        d2 = dict(d)
        d2["month"] = m
        d2["year"]  = year
        d2["label"] = f"{m} {year}"
        d2["win_rate"] = round(d["wins"]/(d["wins"]+d["losses"])*100, 1)
        d2["net_margin"] = round((d["net_revenue"]-d["cogs"]-d["sales_exp"])/d["net_revenue"]*100, 1)
        rows.append(d2)
    return pd.DataFrame(rows)

